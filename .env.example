# ==========================================
# Agenda SIME MD - Telegram Bot & Mini App
# ==========================================

# 1. Telegram Bot Token from @BotFather
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# 2. Secret Key for encrypting passwords stored in SQLite (generate any random string)
SECRET_KEY=generate_random_secret_string_here_32_chars

# 3. Your server domain (e.g. sime.yourdomain.com or IP)
DOMAIN=yourdomain.com

# 4. Telegram Mini App URL (must be HTTPS, e.g. https://yourdomain.com/app)
MINI_APP_URL=https://yourdomain.com/app

# 5. Database path
DATABASE_PATH=./data/agenda.db

# 6. Debug mode (set to false in production)
DEBUG=false
